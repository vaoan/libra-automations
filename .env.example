# Copy to .env (scripts/init-env.sh does it and generates the secrets).
# .env must be IDENTICAL on every machine — especially N8N_ENCRYPTION_KEY,
# or n8n cannot decrypt the stored credentials.

N8N_VERSION=stable

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

N8N_ENCRYPTION_KEY=change-me

# Public base URL for webhooks. Local dev: http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/

# n8n public API key (Settings > n8n API), used by scripts/ to deploy workflows.
N8N_API_KEY=

# Libra database the workflows read from (dev: local Supabase stack).
LIBRA_DB_HOST=host.docker.internal
LIBRA_DB_PORT=54332
LIBRA_DB_NAME=postgres
LIBRA_DB_USER=postgres
LIBRA_DB_PASSWORD=postgres
# Container name of Libra's Postgres, used by scripts/ to register the webhook.
LIBRA_DB_CONTAINER=supabase_db_libra-dev

# Shared secret Libra sends in X-Libra-Webhook-Secret (generated by init-env.sh).
LIBRA_WEBHOOK_SECRET=change-me
# URL Libra's database calls; host.docker.internal reaches n8n from the Supabase container.
LIBRA_WEBHOOK_URL=http://host.docker.internal:5678/webhook/libra-order-events

# Libra's Supabase API (receipts bucket). Dev: the local stack through host.docker.internal.
LIBRA_SUPABASE_URL=http://host.docker.internal:54331
# Service ("Secret") key of that Supabase — reads the private receipts bucket. Never commit.
LIBRA_SUPABASE_SERVICE_KEY=

# Google AI Studio key for the receipt check (free tier).
GEMINI_API_KEY=

# Outgoing email. Dev: the bundled Mailpit. Prod: e.g. smtp.gmail.com:465 + app password.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Libra <no-reply@libra.local>"
